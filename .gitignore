# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Django ───────────────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
*.log
local_settings.py

# Generated by `collectstatic` (output) — never commit. The leading slash anchors
# these to the PROJECT ROOT, so app-level  <app>/static/  folders stay TRACKED.
/staticfiles/
# Project-level static dir — source static lives inside each app instead.
/static/
# Runtime user uploads.
/media/

# ── Secrets — keep the template, never commit real env files ─────────────────
.env
.env.*
!.env.example

# ── Celery ───────────────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

