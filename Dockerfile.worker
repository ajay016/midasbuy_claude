# ── Worker image: Celery + patchright + Chromium ───────────────────────────────
# Only this image carries the browser, and only Chromium (not Firefox/WebKit), so
# it lands around ~1.5 GB instead of the multi-GB "install everything" default.

# Stage 1 — build the virtualenv
FROM python:3.12-slim AS builder
WORKDIR /app

RUN python -m pip install --upgrade pip && python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Stage 2 — runtime + Chromium
FROM python:3.12-slim
WORKDIR /app

# Only the shared libraries Chromium needs at runtime, plus xvfb so headful
# (non-headless) browsing works inside the container.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libatk-bridge2.0-0 libatk1.0-0 libcups2 libdrm2 libxkbcommon0 \
    libx11-xcb1 libxcomposite1 libxdamage1 libxrandr2 libgbm1 libgtk-3-0 \
    libasound2 libpango-1.0-0 libcairo2 fonts-liberation xvfb xauth tzdata \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Download ONLY Chromium for patchright (the project's stealth Playwright fork).
RUN python -m patchright install chromium

COPY . .

# Entrypoint starts a virtual X display, then execs the command below.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
# Strip any CRLF (Windows checkout) so the shebang resolves, then make executable.
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
 && chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
# concurrency = parallel jobs (each slot drives its own browser, so keep small).
CMD ["celery", "-A", "midasbuy_project", "worker", "-l", "info", "--concurrency=2"]
