# Copy to .env and fill in. django-environ reads this at startup.

# ── Core Django ─────────────────────────────────────────────────────────────────────
DEBUG=True
# Set True on a real server: tightens security-related settings. Keep DEBUG=False
# in production.
PRODUCTION=False
SECRET_KEY=change-this-to-a-long-random-string
# Comma-separated. In docker add the web service / your server IP.
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database (PostgreSQL on the HOST, not in a container) ─────────────────────────────────
# Set DB_ENGINE=sqlite to skip Postgres and use the bundled db.sqlite3 file.
DB_ENGINE=postgresql
DB_NAME=midasbuy
DB_USER=postgres
DB_PASSWORD=postgres
# On Windows + Docker Desktop this reaches your host's Postgres.
# When running WITHOUT docker (plain `python manage.py runserver`) use 127.0.0.1.
DB_HOST=host.docker.internal
DB_PORT=5432

# ── Celery / Redis ─────────────────────────────────────────────────────────────────────────────
# Inside docker-compose this is overridden to redis://redis:6379/0.
# For a non-docker local run, start redis and use 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379/0

# ── API authentication ─────────────────────────────────────────────────────────────────────────────────
# Secret for signing JWTs (dashboard logins). Defaults to SECRET_KEY if unset.
JWT_SECRET=
# Fernet key that encrypts merchant API secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If blank, a key is derived from SECRET_KEY (OK for dev; set a real one in prod).
APIAUTH_FERNET_KEY=
# HMAC secret used to sign outgoing webhook payloads (X-Webhook-Signature).
# Defaults to JWT_SECRET if blank.
WEBHOOK_SECRET=
# Allow the open POST /api/auth/register endpoint. Keep False unless you want
# self-service signups (users are normally created by an admin).
APIAUTH_OPEN_REGISTRATION=False

# ── Captcha solver ─────────────────────────────────────────────────────────────────────────────────
# Provider: "decodecaptcha" (default) or "2captcha".
CAPTCHA_PROVIDER=decodecaptcha
# Your provider account key (from the DecodeCaptcha dashboard). Blank = captcha
# auto-solve disabled (falls back to returning the challenge for manual solving).
CAPTCHA_API_KEY=
# TCaptcha aid (AppID) from the slider/prehandle URL (aid=... in cap_union_prehandle).
CAPTCHA_APP_ID=188937037

# DecodeCaptcha-only options:
# Tencent captcha domain seen in the prehandle request (turing/sg .captcha.qcloud.com).
CAPTCHA_DOMAIN=https://turing.captcha.qcloud.com
# Optional url-encoded entry_url from the prehandle request (blank = omit).
CAPTCHA_ENTRY_URL=
# Optional modern-browser User-Agent for the solve (blank = omit; improves success).
CAPTCHA_USER_AGENT=
# Optional proxy (residential strongly recommended). Leave TYPE+ADDRESS blank to skip.
CAPTCHA_PROXY_TYPE=
CAPTCHA_PROXY_ADDRESS=
CAPTCHA_PROXY_PORT=
CAPTCHA_PROXY_USER=
CAPTCHA_PROXY_PASS=

# ── Browser behaviour (existing) ────────────────────────────────────────────────────────────────────────
MIDASBUY_BROWSER_HEADLESS=False
MIDASBUY_CRYPTO_BROWSER_HEADLESS=True
# Optional override for the bot browser's User-Agent (blank = library default).
MIDASBUY_BROWSER_USER_AGENT=

# ── Browser warm-up (keeps the API fast) ─────────────────────────────────────────────────────────
# Pre-build a cached browser session for every logged-in account on startup so the
# first request to each account isn't a slow cold start. Each warmed account is one
# headless Chromium PER gunicorn worker, so run few workers (1-2) when warming.
MIDASBUY_WARM_ON_STARTUP=True
# Countries to warm per account (comma separated). Warm the ones you actually use.
MIDASBUY_WARM_COUNTRIES=bd
# Seconds between keep-warm sweeps so rotation stays fast (0 = warm once at startup).
MIDASBUY_WARM_INTERVAL=600

# ── Bot-account rotation tuning (optional; sensible defaults if unset) ───────────────
# Max billable upstream calls per account per minute before it's rested.
# MIDASBUY_ACCOUNT_CAP_PER_MIN=20
# Consecutive errors before an account is flagged and cooled down.
# MIDASBUY_ACCOUNT_FLAG_THRESHOLD=5
# Seconds a flagged account is rested before reuse.
# MIDASBUY_ACCOUNT_FLAG_COOLDOWN=600
